# Search with ripgrep, select results with fzf (with preview), then open the selections in nvim quickfix
fgv() {
  selected=$(
    rg --color=always --vimgrep --smart-case $@ |
      fzf --multi \
          --color "hl:-1:underline,hl+:-1:underline:reverse" \
	  --delimiter : \
          --preview 'bat --color=always --style=numbers,changes {1} --highlight-line={2}' \
          --preview-window 'down,border-top,+{2}-4' \
	  --bind "f1:toggle-all"
  )

  if [[ $selected != "" ]]; then
    nvim +cw -q <(echo $selected)
  fi
}

# Download and decode hex filenames automatically
dl() {
  local url="$1"
  if [[ -z "$url" ]]; then
    echo "Usage: dl <url>"
    return 1
  fi

  # Extract the last part of the URL path
  local encoded_filename="${url##*/}"

  # Strip any query parameters (e.g., ?id=123)
  encoded_filename="${encoded_filename%%\?*}"

  # Decode hex (e.g., %20 -> \x20)
  local filename=$(python3 -c "import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))" "$encoded_filename")

  # Fallback if filename is empty (e.g. url ends in /)
  if [[ -z "$filename" ]]; then
    filename="downloaded_file"
  fi

  echo "Downloading: $filename"
  wget -c --waitretry=1 -O "$filename" "$url"
}

# Convert markdown file to Word docx
md2word() {
  local input_file="$1"
  if [[ -z "$input_file" ]]; then
    echo "Usage: md2word <input.md> [output.docx]"
    return 1
  fi

  # Determine output filename (uses second argument, or replaces .md with .docx)
  local output_file="${2:-${input_file%.*}.docx}"

  echo "Converting '$input_file' to '$output_file'"

  # Convert with pandoc docker image
  # Pinned to:
  #   v3.9.0.2
  #   Mar 30, 2026 at 3:17 am
  #   https://hub.docker.com/layers/pandoc/core/3.9.0.2-alpine/images/sha256-1e2f9ab16e66e8d2e55a5be8a97ddcec57e882451c178f3bd55e4bcc757b308c
  docker run --rm \
    -v "$(pwd)":/data \
    pandoc/core:3.9.0.2-alpine@sha256:bfca0ecc070ece31b6f56ba668446ab2dc9c973047eebb57b4d0710de8b91d0b \
    "$input_file" -o "$output_file"

  if [ $? -eq 0 ]; then
    echo "Done"
  else
    echo "Conversion failed"
  fi
}

qrcode() {
  if [[ -z "$3" ]]; then
    echo "Usage: qrcode <blocksize> 'https://example.com' output.png"
    return 1
  fi

  local size="$1"
  local input_text="$2"
  local out_file="$3"

  # Generate with qrencode
  # Pinned to:
  #   v20260603
  #   June 3, 2026 at 4:15 am
  #   https://hub.docker.com/layers/backplane/qrencode/20260603/images/sha256-1d3c5fce9948af0d25fce3eb2dab8860dfa3ec7babfd2543a62879164ea8f054
  local image_id="backplane/qrencode:20260603@sha256:f6151cdfc3c1e970b07185add917c232e33d360cf55ed9445b2649c33df8d73e"

  docker run --rm -i -v "$(pwd)":/data/app -w /data/app "$image_id" -s "$size" -o "$out_file" "$input_text"
