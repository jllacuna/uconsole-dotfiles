# Search with ripgrep, select results with fzf (with preview), then open the selections in nvim quickfix
fgv() {
  selected=$(
    rg --color=always --vimgrep --smart-case $@ |
      fzf --multi \
          --color "hl:-1:underline,hl+:-1:underline:reverse" \
	  --delimiter : \
          --preview 'bat --color=always --style=numbers,changes {1} --highlight-line={2}' \
          --preview-window 'down,border-top,+{2}-4' \
	  --bind "f1:toggle-all"
  )

  if [[ $selected != "" ]]; then
    nvim +cw -q <(echo $selected)
  fi
}

# Download and decode hex filenames automatically
dl() {
  local url="$1"
  if [[ -z "$url" ]]; then
    echo "Usage: dl <url>"
    return 1
  fi

  # Extract the last part of the URL path
  local encoded_filename="${url##*/}"

  # Strip any query parameters (e.g., ?id=123)
  encoded_filename="${encoded_filename%%\?*}"

  # Decode hex (e.g., %20 -> \x20)
  local filename=$(python3 -c "import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))" "$encoded_filename")

  # Fallback if filename is empty (e.g. url ends in /)
  if [[ -z "$filename" ]]; then
    filename="downloaded_file"
  fi

  echo "Downloading: $filename"
  wget -c --waitretry=1 -O "$filename" "$url"
}

# Convert markdown file to Word docx
md2word() {
  local input_file="$1"
  if [[ -z "$input_file" ]]; then
    echo "Usage: md2word <input.md> [output.docx]"
    return 1
  fi

  # Determine output filename (uses second argument, or replaces .md with .docx)
  local output_file="${2:-${input_file%.*}.docx}"

  echo "Converting '$input_file' to '$output_file'"

  # Convert with pandoc docker image
  # Pinned to:
  #   v3.9.0.2
  #   Mar 30, 2026 at 3:17 am
  #   https://hub.docker.com/layers/pandoc/core/3.9.0.2-alpine/images/sha256-1e2f9ab16e66e8d2e55a5be8a97ddcec57e882451c178f3bd55e4bcc757b308c
  docker run --rm \
    -v "$(pwd)":/data \
    pandoc/core:3.9.0.2-alpine@sha256:bfca0ecc070ece31b6f56ba668446ab2dc9c973047eebb57b4d0710de8b91d0b \
    "$input_file" -o "$output_file"

  if [ $? -eq 0 ]; then
    echo "Done"
  else
    echo "Conversion failed"
  fi
}

qrcode() {
  if [[ -z "$3" ]]; then
    echo "Usage: qrcode <blocksize> 'https://example.com' output.png"
    return 1
  fi

  local size="$1"
  local input_text="$2"
  local out_file="$3"

  # Generate with qrencode
  # Pinned to:
  #   v20260603
  #   June 3, 2026 at 4:15 am
  #   https://hub.docker.com/layers/backplane/qrencode/20260603/images/sha256-1d3c5fce9948af0d25fce3eb2dab8860dfa3ec7babfd2543a62879164ea8f054
  local image_id="backplane/qrencode:20260603@sha256:f6151cdfc3c1e970b07185add917c232e33d360cf55ed9445b2649c33df8d73e"

  docker run --rm -i -v "$(pwd)":/data/app -w /data/app "$image_id" -s "$size" -o "$out_file" "$input_text"
  echo "Saved QR code to $(pwd)/$out_file (Block size: ${size}px)"
}

# Resolve the latest docker tag for a specific node version and OS, at least RELEASE_COOLDOWN_DAYS old (default 7), pinned by digest
# Usage: pinned_node_image VERSION [OS]
#   VERSION: a specific node version, e.g. "20.11.1"
#   OS: docker tag os suffix, e.g. alpine, bookworm, bullseye, trixie, slim (default: alpine)
# Prints e.g. "24.18.0-alpine3.24@sha256:<digest>" for pinning in a Dockerfile/docker run
pinned_node_image() {
  local version="${1#v}"
  local os="${2:-alpine}"

  if [[ -z "$version" ]]; then
    echo "pinned_node_image: usage: pinned_node_image VERSION [OS]" >&2
    return 1
  fi

  local cooldown_days="${RELEASE_COOLDOWN_DAYS:-7}"
  local cutoff_epoch=$(date -u -d "${cooldown_days} days ago" +%s)

  # alpine tags carry an extra alpine-version suffix (e.g. -alpine3.24); other OS tags
  # (bookworm, bullseye, trixie, slim, ...) are an exact "-<os>" suffix with nothing after
  local suffix_regex
  if [[ "$os" == "alpine" ]]; then
    suffix_regex="alpine[0-9]+\\.[0-9]+"
  else
    suffix_regex="${os//./\\.}" # escape "."
  fi
  local version_regex="${version//./\\.}-${suffix_regex}"

  # Get the image name with fully specified node and os versions and pinned to index digest
  # - ensure tag is active
  # - ensure the tag has a usable multi-arch manifest digest (older tags can have a null one)
  # - ensure all images associated with tag were last pushed before RELEASE_COOLDOWN_DAYS
  #   - Removes milliseconds and converts to an epoch using jq fromdateiso8601
  local tag
  tag=$(curl -s "https://hub.docker.com/v2/repositories/library/node/tags?page_size=100&ordering=last_updated&name=${version}-${os}" | jq -r --arg re "^${version_regex}\$" --argjson cutoff_epoch "$cutoff_epoch" '
    .results
    | map(select(
        .tag_status == "active"
        and .digest != null
        and (.name | test($re))
        and (
          ((.images // []) | map(.last_pushed | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) | max) as $push_epoch
          | $push_epoch != null and $push_epoch <= $cutoff_epoch
        )
      ))
    | first
    | if . == null then empty else "\(.name)@\(.digest)" end
  ')

  if [[ -z "$tag" ]]; then
    echo "pinned_node_image: no cooldown-eligible $os image with a usable digest found on Docker Hub for node $version" >&2
    return 1
  fi

  echo "$tag"
}

# Resolve the latest LTS node.js alpine docker image at least RELEASE_COOLDOWN_DAYS old (default 7), pinned by digest
# Prints e.g. "24.18.0-alpine3.24@sha256:<digest>" for pinning in a Dockerfile/docker run
latest_node_lts_image() {
  local cooldown_days="${RELEASE_COOLDOWN_DAYS:-7}"
  local cutoff=$(date -u -d "${cooldown_days} days ago" +%Y-%m-%d)

  # Get the latest LTS node version before RELEASE_COOLDOWN_DAYS
  local node_version
  node_version=$(curl -s https://nodejs.org/dist/index.json | jq -r --arg cutoff "$cutoff" '
    map(select(.lts != false and .date <= $cutoff))
    | sort_by(.date)
    | last
    | .version // empty
  ')

  if [[ -z "$node_version" ]]; then
    echo "latest_node_lts_image: no active LTS release at least ${cooldown_days} days old found" >&2
    return 1
  fi
  node_version="${node_version#v}"

  pinned_node_image "$node_version"
}
