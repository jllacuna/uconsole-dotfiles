#!/usr/bin/env bash

source "$CHEZMOI_WORKING_TREE/lib/github-release.sh"

RUSTUP_REPO="rust-lang/rustup"
TARGET="aarch64-unknown-linux-gnu"
CARGO_BIN=~/.cargo/bin

# rustup has no GitHub releases, only tags
RUSTUP_TAG=$(github_tag_before "$RUSTUP_REPO")

if [ -z "$RUSTUP_TAG" ]; then
  echo "rustup: no release at least $COOLDOWN_DAYS days old found, skipping"
  exit 0
fi

RUSTUP_VERSION=$(rustup --version 2> /dev/null)
VERSION_REGEX='[0-9\.]+'
[[ $RUSTUP_VERSION =~ $VERSION_REGEX ]]
RUSTUP_CURRENT_TAG=${BASH_REMATCH[0]}

if [ "$RUSTUP_TAG" = "$RUSTUP_CURRENT_TAG" ]; then
  echo "rustup is up-to-date: v$RUSTUP_TAG"
else
  if [ -z "$RUSTUP_CURRENT_TAG" ]; then
    echo "Installing rustup: v$RUSTUP_TAG"
  else
    echo "Updating rustup: v$RUSTUP_TAG"
  fi

  TMP=$(mktemp -d)
  ASSET_URL="https://static.rust-lang.org/rustup/archive/$RUSTUP_TAG/$TARGET/rustup-init"
  curl --progress-bar -Lo $TMP/rustup-init "$ASSET_URL"

  # Validate the checksum
  SHA256=$(sha256sum $TMP/rustup-init | cut -d' ' -f1)
  CHECKSUM=$(curl -sL "$ASSET_URL.sha256" | cut -d' ' -f1)

  if [[ "$SHA256" != "$CHECKSUM" ]]; then
    echo "rustup checksums do NOT match"
    rm -fr $TMP
    exit 1
  fi

  chmod 755 $TMP/rustup-init
  $TMP/rustup-init -y --no-modify-path
  rm -fr $TMP
fi

# The rust toolchain itself isn't cooldown-gated: it's distributed from
# static.rust-lang.org by the Rust project's own release infrastructure, not
# a GitHub-Actions-released project, and rustup verifies each component's
# checksum against the channel manifest itself.
$CARGO_BIN/rustup update

# Install completions
# bash
$CARGO_BIN/rustup completions bash | sudo tee /usr/share/bash-completion/completions/rustup > /dev/null
$CARGO_BIN/rustup completions bash cargo | sudo tee /usr/share/bash-completion/completions/cargo > /dev/null

# zsh
$CARGO_BIN/rustup completions zsh | sudo tee /usr/share/zsh/site-functions/_rustup > /dev/null
$CARGO_BIN/rustup completions zsh cargo | sudo tee /usr/share/zsh/site-functions/_cargo > /dev/null
