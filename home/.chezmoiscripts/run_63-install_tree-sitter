#!/usr/bin/env bash

source "$CHEZMOI_WORKING_TREE/lib/cargo-release.sh"

# Get latest crate version at least COOLDOWN_DAYS old
VERSION=$(cargo_crate_version tree-sitter-cli)

if [ -z "$VERSION" ]; then
  echo "tree-sitter: no release at least $COOLDOWN_DAYS days old found, skipping"
  exit 0
fi

TREESITTER_VERSION=$(tree-sitter --version 2> /dev/null)
VERSION_REGEX='[0-9\.]+'
[[ $TREESITTER_VERSION =~ $VERSION_REGEX ]]
CURRENT_VERSION=${BASH_REMATCH[0]}

if [ "$VERSION" = "$CURRENT_VERSION" ]; then
  echo "tree-sitter is up-to-date: v$VERSION"
  exit 0
fi

if [ -z "$CURRENT_VERSION" ]; then
  echo "Installing tree-sitter: v$VERSION"
else
  echo "Updating tree-sitter: v$VERSION"
fi

~/.cargo/bin/cargo install --locked tree-sitter-cli --version $VERSION
