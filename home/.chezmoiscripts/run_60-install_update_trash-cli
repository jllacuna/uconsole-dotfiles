#!/usr/bin/env bash

source "$CHEZMOI_WORKING_TREE/lib/pypi-release.sh"

BIN=~/.local/bin

# Get latest trash-cli version at least COOLDOWN_DAYS old
VERSION=$(pypi_package_version trash-cli)

if [ -z "$VERSION" ]; then
  echo "trash-cli: no release at least $COOLDOWN_DAYS days old found, skipping"
  exit 0
fi

CURRENT_VERSION=$($BIN/trash --version 2> /dev/null)

if [ "$VERSION" = "$CURRENT_VERSION" ]; then
  echo "trash-cli is up-to-date: v$VERSION"
  exit 0
fi

if [ -z "$CURRENT_VERSION" ]; then
  echo "Installing trash-cli: v$VERSION"
  $BIN/uv tool install "trash-cli[completion]==$VERSION"
else
  echo "Updating trash-cli: v$VERSION"
  $BIN/uv tool upgrade "trash-cli==$VERSION"
fi

# Set up completions
cmds=(trash-empty trash-list trash-restore trash-put trash)
for cmd in ${cmds[@]}; do
  $BIN/$cmd --print-completion bash | sudo tee /usr/share/bash-completion/completions/$cmd > /dev/null
  $BIN/$cmd --print-completion zsh | sudo tee /usr/share/zsh/site-functions/_$cmd > /dev/null
done
