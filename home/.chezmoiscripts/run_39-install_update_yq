#!/usr/bin/env bash

source "$CHEZMOI_WORKING_TREE/lib/github-release.sh"

REPO="https://github.com/mikefarah/yq"
BIN=~/.local/bin
COMPLETION=~/.zsh/completion

# Get latest release at least COOLDOWN_DAYS old
TAG=$(github_release_tag "${REPO#https://github.com/}")
TAG=${TAG#v}

if [ -z "$TAG" ]; then
  echo "yq: no release at least $COOLDOWN_DAYS days old found, skipping"
  exit 0
fi

YQ_VERSION=$(yq --version 2>/dev/null)
VERSION_REGEX='[0-9\.]+$'
[[ $YQ_VERSION =~ $VERSION_REGEX ]]
CURRENT_TAG=${BASH_REMATCH[0]}

if [ "$TAG" = "$CURRENT_TAG" ]; then
  echo "yq is up-to-date: v$TAG"
  exit 0
fi

if [ -z "$CURRENT_TAG" ]; then
  echo "Installing yq: v$TAG"
else
  echo "Updating yq: v$TAG"
fi

ASSET=yq_linux_arm64
curl --create-dirs --progress-bar -Lo $BIN/$ASSET.download $REPO/releases/download/v$TAG/$ASSET

# Validate the checksum. yq packs every hash algorithm into one file, in the
# column order listed in checksums_hashes_order.
HASH_LINE=$(curl -sL $REPO/releases/download/v$TAG/checksums_hashes_order | grep -n '^SHA-256$' | cut -d: -f1)
FIELD=$((HASH_LINE + 1))
SHA256=$(sha256sum $BIN/$ASSET.download | cut -d' ' -f1)
CHECKSUM=$(curl -sL $REPO/releases/download/v$TAG/checksums | grep "$ASSET\s" | sed 's/  /\t/g' | cut -f$FIELD)

if [[ "$SHA256" != "$CHECKSUM" ]]; then
  echo "yq checksums do NOT match"
  rm $BIN/$ASSET.download
  exit 1
fi

mv $BIN/$ASSET.download $BIN/yq
chmod 755 $BIN/yq

# Generate completions
$BIN/yq shell-completion zsh > $COMPLETION/_yq
