#!/usr/bin/env bash

source "$CHEZMOI_WORKING_TREE/lib/github-release.sh"

DIST="https://nodejs.org/dist"
DEST=~/.local/share
BIN=~/.local/bin
MAN_ROOT=~/.local/share/man
PLATFORM="linux-arm64"

# Get latest release at least COOLDOWN_DAYS old
TAG=$(curl -s "$DIST/index.json" | jq -r --arg cutoff "$(cooldown_cutoff)" '
  map(select(.date <= $cutoff))
  | sort_by(.date)
  | last
  | .version // empty
')

if [ -z "$TAG" ]; then
  echo "node: no release at least $COOLDOWN_DAYS days old found, skipping"
  exit 0
fi

CURRENT_TAG=$(node --version 2> /dev/null)

if [ "$TAG" = "$CURRENT_TAG" ]; then
  echo "node is up-to-date: $TAG"
  exit 0
fi

if [ -z "$CURRENT_TAG" ]; then
  echo "Installing node: $TAG"
else
  echo "Updating node: $TAG"
fi

# Capture existing global packages (besides bundled npm) to carry forward
# Reinstalling lets npm re-resolve each package against the new node's `engines` requirement
# and rebuild any native addons
GLOBAL_PACKAGES=()
if [ -x "$DEST/node/bin/npm" ]; then
  mapfile -t GLOBAL_PACKAGES < <("$DEST/node/bin/npm" ls -g --depth=0 --json 2> /dev/null | jq -r '.dependencies // {} | keys[] | select(. != "npm")')
fi

FILENAME="node-$TAG-$PLATFORM.tar.gz"
curl --create-dirs --progress-bar -Lo $DEST/$FILENAME "$DIST/$TAG/$FILENAME"

# Validate the checksum
SHA256=$(sha256sum $DEST/$FILENAME | cut -d' ' -f1)
CHECKSUM=$(curl -sL "$DIST/$TAG/SHASUMS256.txt" | awk -v f="$FILENAME" '$2 == f { print $1 }')

if [[ "$SHA256" != "$CHECKSUM" ]]; then
  echo "node checksums do NOT match"
  rm -f $DEST/$FILENAME
  exit 1
fi

# Remove existing install
rm -fr $DEST/node

# Extract the tarball
mkdir -p $DEST/node && cd $DEST && tar xzf $FILENAME -C node --strip-components 1 && rm $FILENAME

# Symlink the commands
mkdir -p $BIN
ln -sf $DEST/node/bin/node $BIN/node
ln -sf $DEST/node/bin/npm $BIN/npm
ln -sf $DEST/node/bin/npx $BIN/npx
[ -f $DEST/node/bin/corepack ] && ln -sf $DEST/node/bin/corepack $BIN/corepack

# Symlink man pages: node.1, plus every npm-*.1/.5/.7 page npm bundles.
# Globbed by section number rather than hardcoded, since npm's command list
# (and thus its page count) changes across releases
for f in $DEST/node/share/man/man*/*.[0-9] $DEST/node/lib/node_modules/npm/man/man*/*.[0-9]; do
  [ -f "$f" ] || continue
  section="${f##*.}"
  mkdir -p "$MAN_ROOT/man$section"
  ln -sf "$f" "$MAN_ROOT/man$section/$(basename "$f")"
done

# Reinstall previously-installed global packages under the new node
if [ ${#GLOBAL_PACKAGES[@]} -gt 0 ]; then
  echo "Reinstalling global packages: ${GLOBAL_PACKAGES[*]}"
  $BIN/npm install -g "${GLOBAL_PACKAGES[@]}"
fi

# Set up completions
$BIN/npm completion | sudo tee /usr/share/zsh/site-functions/_npm > /dev/null
