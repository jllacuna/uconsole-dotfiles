{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "acceptEdits",
    "blockReadsOutsideWorkingDirectories": true
  },
  "autoUpdatesChannel": "stable",
  "theme": "dark",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 365
}
